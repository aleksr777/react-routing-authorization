# NestJS backend base URL including the /api prefix.
# Local development and local production builds fall back to http://localhost:5174/api.
# Set this explicitly for deployed builds; non-local production URLs require HTTPS.
# GitHub Pages deployment reads the repository Actions variable with the same name.
VITE_API_URL=http://localhost:5174/api

# Browser/Vite base path. Keep / for local/root hosting.
# GitHub Pages deployment sets this automatically to /<repository-name>/.
VITE_BASE_PATH=/
